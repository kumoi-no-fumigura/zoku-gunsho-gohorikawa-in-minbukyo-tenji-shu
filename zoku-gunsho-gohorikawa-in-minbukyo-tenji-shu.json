    "73",
    "74",
    "75",
    "76"
   ]
  },
  {
   "id": "zoku-gunsho-gohorikawa-in-minbukyo-tenji-shu-0008",
   "pid": "nao-734455",
   "pages": [
    8
   ],
   "text": "すきゆき月日のほとを思ふにも数なき物は涙なりけりいけ水のすめはすむらんことはりはもとの心のきよき成けり御はての日御かよりとてさしをかれたりけるこの秋もかはらぬ姫への露の色にこけの袂を思こそやれと有をたれともみ分ねは殿の御まきれ事にやとて御くるまに入させつ遣ふとたに色もりかれすめくりあふ我身をはこつ袖の涙にせとにいてゝむけにふけぬるほとに又殿よりとてかきくらしかさぬる秋はめくるとも猶墨染の色やひかたき又御返しいとこゝろへすなからよのうきに秋のつらさをかさねてもひとへにしほる墨染の袖ほとへて後はしめの哥は六条のみにいゑひらさることしたりしと宰相殿に語けるとき〳〵祥室けふよりの花のたもとのあらましに泪かさなる墨染の袖返事墨染の袖もひかたき秋なれと問ふ人もしやりきて寄けれ",
   "poems": [
    "77",
    "78",
    "79",
    "80",
    "81",
    "82",
    "83",
    "84"
   ]
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "もろ人をわたすちかひのたえせぬはみたらし川のとつ宮敷",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "2",
   "text": "かきりありし鶴のはやしのかたみをはとゝめおきつるいかるかの里",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "法修寺舎利の御ばこの哥をみて"
  },
  {
   "seq": "3",
   "text": "聞たにも雲井の外のかひもなしそむきにし世の猶そ忠しき",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "恐しきのみるめのまへを思やれそむきにし世のよその哀に",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返し",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "いか斗かなしとかしも世のうさに捨るこの身の身のおや岩心は",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "花の色もうれ世にかふる墨染の袖や浮世に猶しつくらん",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "一巻そめを花の衣にたちかへし泪の色はあはれともみき",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返し",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "君かいるまことの道の月の影夢と見し世も今やてらさむ",
   "kana": "",
   "speaker": "寂空",
   "page": 1,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "やみふかきうき世の夢の御めぬとて天らさはうれし在明の月",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "茶へし",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "紫のいろにつたへし袖のうへせかはりにけりと聞そ恐しき",
   "kana": "",
   "speaker": "沙弥蓮生",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "あくるまのけふは昨日にかわるよの衣の名はいふかひもなし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返し",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "墨染の袖をかさねて恐しきはそむくにつけてそむく世中",
   "kana": "",
   "speaker": "いゑなか",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "いける世にそむくのみこそ恐しけれあすともまたぬ老の衣は",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "かへし",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "かたみとはいふもをろかにいひしらす心にあまるほとをみせすや",
   "kana": "",
   "speaker": "権律師修栄",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "あさからぬ契もいまは白雪のかさなるとしのあとに見え南",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "いく千世かあまの拝衣たちなれんともなふ鶴の雲のかよひち",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶴契遐年",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "さをしかの峯のたちともあらはれて妻とふ山を出る月かけ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "殿哥合月下鹿",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "あしかきに木のは吹しくおひ風の音もまちかくうつ衣かな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "風前擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "やま姫のそめぬ衣もくれなひの色に出てや今はこひまし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄衣恋",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "おもかけはさゝぬ鏡のかけにたに涙へたてゝえやは見えける",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄鏡恋",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "しかすかにまたたえやらぬかた糸の逢を限りと年はへにけり",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "孫",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "さらにまたかきほの蘇もをとつれて里馴そむる秋の初風",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "おほせことにておほせことにておほして"
  },
  {
   "seq": "23",
   "text": "ふく風のをとはの山のさねかつら秋くるからに露こほれつゝ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "たれもまつ秋はならひの月なれと猶日かりそふゆふくれの空",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋月",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "辰田山そのてうつろふ木末より時雨ぬ色にいてぬつきかけ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "哥合名所月",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "清見没月の空にはせきもふせいたつらにたつ秋の白なみ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "いくかへりすまのうら人和かための秋とはなしに自を見るらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "ゆくすゑのけふりとたにもわかさかし心のやみはいつかはるへき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "おもひやる心の空の月の気にとまるやみちのはるゝをそ詩",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返し",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "かなしきはうき世のとかとそむけとも只恋し雲のなくさめそなき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "世をそむきぬと聞て人のとふらひて侍ける返し"
  },
  {
   "seq": "31",
   "text": "夢の世に別れて後の恋しさをいかにせんとかきみになれけん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "くるとあくとなかす涙の紅に色も別し墨染のそう",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "身をこかす烟くらへの別路はをくるへくやは物の恐しき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "おなし比たにゝ煙のなと申ける人に"
  },
  {
   "seq": "34",
   "text": "うき身まてかはれはかはる世中をなになからへて明暮しけん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐歌",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "夢にたにむかしは又もみねに生る色や緑の風そ忠しき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "くすのはのいく秋風をからみてもかへらぬ物は昔なりけり",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "末の世をてらすと見えし月なれは西の主にや光そふらん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "したえとも花の其屋の違けれは空行月にねをのみそなく",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "見てしかたうき世の衣ぬき捨てをとりひらけん花のころもを",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "うきなみに霧も霞も立かさねしほたれ夜かりく日そなき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "こひりふるかけたに見へぬ夢の世にあはれ何とて在明の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "ゆめよりもはかなき露の秋の秋のよに貴き恨やきえのこりけん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "たちりかれうき世出へきつまとてや花亀衣きつゝなれけん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "かたみゆへ又せきとめぬ涙かななれて別はこりはてし世に",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "みたれ落る我ものかられ身にそへて今はあたなる袖の白玉は",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "いかさまに忍ふる袖をしほれとて秋をかたみと露の消けん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "遣ふまても何に命のかゝるよにふるも悲しき雪つもならん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "盃ふりたる朝しけもちまいるよし申遣るに心不そさおほしめしやらるゝ御こと一世のつゐてに"
  },
  {
   "seq": "48",
   "text": "ふりつもるあとなき雪をみてもまつ同し涙にかきくらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "おりを過さぬをほせことも出なし泪にかきくれて"
  },
  {
   "seq": "49",
   "text": "おもひのミ日数や雪につけるらんあとおき庭も諸消ぬまて",
   "kana": "",
   "speaker": "政より",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "おなし雪のあした大"
  },
  {
   "seq": "50",
   "text": "うき身世にきえぬもつらきためしとや袖の雲たに払は登る児",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "うき事のふりてつもれる雪の中はいとはぬ道も諸そ稀なる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "御かへし",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "きえとまるほとも恐しき巻染の袖には雪縄ふるかひもなし",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "のこせなく年も我身もいりはせゝとはれぬ雪のほとは見へける",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "いとさひしく見りたさるゝにも"
  },
  {
   "seq": "54",
   "text": "宿からの都もしらすふる雪に山のいくへをおもひこそやれ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "しほるらん霞の袖の春の色をきりにまよひし秋のかたみを",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "としかへりて日数過て後これよりおとろかされてつゐてに"
  },
  {
   "seq": "56",
   "text": "春しらぬみ山の雪のふかきまてとはるへしとはおもはとりしを",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "はかりはひとりなかめてこそ侍りし"
  },
  {
   "seq": "57",
   "text": "すみそめの衣いつれとわかぬまに霞や常にたちかはるらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "わかこゝろのあさゝこそとありけれは又京"
  },
  {
   "seq": "58",
   "text": "袖のうへのかきしゐ柴にくみふれはみ山の雪は春もしる覧",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "もしられ候はて",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "くまもなく光をてらす秋の月御こそは西の山に入らめ",
   "kana": "",
   "speaker": "さか",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "この返事こまかにて"
  },
  {
   "seq": "60",
   "text": "一此世にもにこらをりけり秋の月花のうてなに先ますらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "これをも九品れんたひに思ひやりまてせさせ給へ"
  },
  {
   "seq": "61",
   "text": "うき世をは霞の色にぬきすてゝ花の袖にて春をしか覧",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "たのもしらこそ候へ"
  },
  {
   "seq": "62",
   "text": "秋の霧春の霞と立かはね泪にしほるあまの袖のみ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "御むるまてあらまし夢のよの中を見し七月の在明の空",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "こそ数なるも藤ならぬも哀尽せぬ恨にては侍らひけり"
  },
  {
   "seq": "64",
   "text": "はかなさの春の夢かとみしよにも末はの秋の露の世中",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "いかに候事に御身にとりて長月の在明甘ふし待のほとたへかたくあはれに思ひしみてさふらふに小倉の山のしかのなくさへ"
  },
  {
   "seq": "65",
   "text": "たちかへしあまの衣の袖のなをうき世に残す妻を狂きけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "とをくともしかふ心の契あらは花のうてなの寄もへたてし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "我なから捨しぬよを打かへし又おしみとふらふか今さへまたおそろしくもきふらへとも秋より冬まて思ひつめ候し事を仏にひかれまいらせてうるいたしそめ候て中々にそゝめかねたる様に"
  },
  {
   "seq": "67",
   "text": "秋の月影もしられぬ山陰の底にたにも露はこほれき",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "身をなきに思ひなしても恐しきはうき世を捨し秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "君か代をいはひし春も百千鳥よをうくひすと鳴を聞にも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "これも又おしみなからもそむく世とすゝむる道のしるへなりけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "まつ泪の氷はいとゝとけそめ候ぬる心地してこそけにも候つれ"
  },
  {
   "seq": "71",
   "text": "谷陰の葉のくち木の烟ともならん夕の空をなかめよ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "とまておもひなしまいらせてこそ候へ"
  },
  {
   "seq": "72",
   "text": "かきつめてうき水くきの諸なれとしれす忍ふかたみならすや",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "きかせたはしまさは"
  },
  {
   "seq": "73",
   "text": "かきやれはその事となく水くきに泪のかゝる心ならひに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "と心をやりて又こかくれてはつかしく"
  },
  {
   "seq": "74",
   "text": "あはれいかに北春雨のつれ〳〵とふるにつけても袖ぬらすめ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "をしはかりまいらせ候も"
  },
  {
   "seq": "75",
   "text": "まよひこし我心からにこりけりすめはすみける池の水哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "人の夢に見参らせたりける哥"
  },
  {
   "seq": "76",
   "text": "此世にてあひみん事はしかすかにはかなき夢を頼む計そ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "すきやすき月日のほとを思ふにも数なき物は涙なりけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "御らんせられて大殿"
  },
  {
   "seq": "78",
   "text": "いけ水のすめはすむらんことはりはもとの心のきよき成けり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "この秋もかはらぬ姫への露の色にこけの袂を思こそやれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "御はての日御かよりとてさしをかれたりける"
  },
  {
   "seq": "80",
   "text": "遣ふとたに色もりかれすめくりあふ我身をはこつ袖の涙に",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "と有をたれともみ分ねは殿の御まきれ事にやとて御くるまに入させつ"
  },
  {
   "seq": "81",
   "text": "かきくらしかさぬる秋はめくるとも猶春染の色やひかたき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "せとにいてゝむけにふけぬるほとに又殿よりとて"
  },
  {
   "seq": "82",
   "text": "よのうきに秋のつらさをかさねてもひとへにしほる墨染の袖",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "又御返しいとこゝろへすなから"
  },
  {
   "seq": "83",
   "text": "けふよりの花のたもとのあらましに泪かさなる墨染の袖",
   "kana": "",
   "speaker": "祥室",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "ほとへて後はしめの哥は六条のみにいゑひらさることしたりしと宰相殿に語けるとき〳〵"
  },
  {
   "seq": "84",
   "text": "墨染の袖もひかたき秋なれと問ふ人もしやりきて寄けれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734455",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "返事",
   "kotobagaki": ""
  }
 ],
